<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Obligations owed longer than two minutes: an order whose own
             invoice or shipment never came to carry the step. -->
        <job name="hyva_inventory_order_reservation_recover" instance="Hyva\InventoryOrderReservation\Cron\RecoverOwed" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>
