<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- The obligation an order carries from its creation: what was
         ordered, per sku, and whether its stock side has been registered.
         Written in the order's own save; never rewritten by later edits to
         the order; the only record this module consults. -->
    <table name="hyva_inventory_order_stock_registration" resource="default" engine="innodb" comment="Stock registration owed by orders created through the API">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Product ID the line was recorded for"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="255" comment="SKU"/>
        <column xsi:type="varchar" name="product_type" nullable="true" length="32" comment="Product type at creation"/>
        <column xsi:type="decimal" name="qty_ordered" scale="4" precision="12" unsigned="false" nullable="false" default="0" comment="Quantity ordered at creation"/>
        <column xsi:type="int" name="website_id" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="int" name="stock_id" unsigned="true" nullable="true" comment="Inventory stock ID (null without Inventory)"/>
        <column xsi:type="varchar" name="mode" nullable="false" length="16" comment="inventory or legacy"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="owed" comment="owed, done or refused (given up after repeated failures)"/>
        <column xsi:type="varchar" name="settled_by" nullable="true" length="32" comment="registration, balanced, compensation or manual"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="The last failure, for the admin message"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Attempts so far"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="completed_at" on_update="false" nullable="true" comment="Completed At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="HYVA_INVENTORY_ORDER_STOCK_REGISTRATION_ORDER_ID_SALES_ORDER_ENTITY_ID" table="hyva_inventory_order_stock_registration" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="HYVA_INVENTORY_ORDER_STOCK_REGISTRATION_ORDER_ID_SKU">
            <column name="order_id"/>
            <column name="sku"/>
        </constraint>
        <index referenceId="HYVA_INVENTORY_ORDER_STOCK_REGISTRATION_STATUS_CREATED_AT" indexType="btree">
            <column name="status"/>
            <column name="created_at"/>
        </index>
    </table>
</schema>
