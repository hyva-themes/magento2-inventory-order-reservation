<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Hyva\InventoryOrderReservation\Api\StockRegistrationInterface" type="Hyva\InventoryOrderReservation\Model\StockRegistration"/>
    <preference for="Hyva\InventoryOrderReservation\Api\CapabilitiesInterface" type="Hyva\InventoryOrderReservation\Model\CapabilitiesService"/>
    <preference for="Hyva\InventoryOrderReservation\Api\Data\CapabilitiesInterface" type="Hyva\InventoryOrderReservation\Model\Data\Capabilities"/>
    <!-- One handler per store mode, built on first use; the registration picks
         by the obligation's mode. The inventory handler comes with
         Hyva_InventoryOrderReservationMsi, which adds it to this map. -->
    <virtualType name="Hyva\InventoryOrderReservation\Model\Handler\Pool" type="Magento\Framework\ObjectManager\TMap">
        <arguments>
            <argument name="type" xsi:type="string">Hyva\InventoryOrderReservation\Model\Handler\HandlerInterface</argument>
            <argument name="array" xsi:type="array">
                <item name="legacy" xsi:type="string">Hyva\InventoryOrderReservation\Model\Handler\LegacyHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Hyva\InventoryOrderReservation\Model\StockRegistration">
        <arguments>
            <argument name="handlers" xsi:type="object">Hyva\InventoryOrderReservation\Model\Handler\Pool</argument>
        </arguments>
    </type>
    <type name="Hyva\InventoryOrderReservation\Model\Readiness">
        <arguments>
            <argument name="handlers" xsi:type="object">Hyva\InventoryOrderReservation\Model\Handler\Pool</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="hyva_inventory_order_reservation_list" xsi:type="object">Hyva\InventoryOrderReservation\Console\Command\ListOwedCommand</item>
                <item name="hyva_inventory_order_reservation_run" xsi:type="object">Hyva\InventoryOrderReservation\Console\Command\RunOwedCommand</item>
            </argument>
        </arguments>
    </type>
</config>
